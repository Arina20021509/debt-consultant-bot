# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env не попадает в Git.

# Ключ авторизации (Authorization key) из личного кабинета GigaChat API
GIGACHAT_CREDENTIALS=

# Для физлиц — GIGACHAT_API_PERS
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Pro

# Поиск по базе знаний: bm25 (бесплатно) или embeddings (эмбеддинги GigaChat, платно)
RETRIEVER=bm25

# Путь к сертификату НУЦ Минцифры (russian_trusted_root_ca.cer). Можно оставить пустым для демо.
GIGACHAT_CA_BUNDLE=

# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Необязательно: ID чата, куда бот присылает новые заявки (узнать — команда /myid в боте)
TELEGRAM_ADMIN_CHAT_ID=
